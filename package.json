{
  "name": "necromancer",
  "version": "0.1.0",
  "description": "Revives abandoned open-source Node repositories",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "necromancer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "execa": "^9.5.2",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/semver": "^7.5.8",
    "fast-check": "^3.22.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
